 void execute_io(io_context_t ctx, int fd, std::vector<AlignedRead> &read_reqs, uint64_t n_retries = 0)
 {
+    // The JNI prototype uses synchronous reads so a failed request cannot leave
+    // kernel AIO operations referring to buffers whose stack has unwound.
+    (void)ctx;
+    (void)n_retries;
+    for (const auto &req : read_reqs)
+    {
+        size_t completed = 0;
+        while (completed < req.len)
+        {
+            ssize_t result = ::pread(fd, static_cast<char *>(req.buf) + completed, req.len - completed,
+                                     req.offset + completed);
+            if (result < 0 && errno == EINTR)
+                continue;
+            if (result < 0)
+                throw diskann::ANNException("pread failed", errno, __FUNCSIG__, __FILE__, __LINE__);
+            if (result == 0)
+                throw diskann::ANNException("Unexpected end of disk index", -1, __FUNCSIG__, __FILE__, __LINE__);
+            completed += (size_t)result;
+        }
+    }
+    return;
